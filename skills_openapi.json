  "components": {
    "schemas": {
      "Body_api_upload_file_api_skills_upload_file_post": {
        "properties": {
          "file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "File"
          }
        },
        "type": "object",
        "required": [
          "file"
        ],
        "title": "Body_api_upload_file_api_skills_upload_file_post"
      },
      "CalculateROIRequest": {
        "properties": {
          "enterprise_id": {
            "type": "string",
            "title": "Enterprise Id",
            "description": "企业 ID，如 'jyuh'"
          },
          "policy_title": {
            "type": "string",
            "title": "Policy Title",
            "description": "政策标题"
          },
          "policy_summary": {
            "type": "string",
            "title": "Policy Summary",
            "description": "政策摘要或内容"
          },
          "success_probability": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Success Probability",
            "description": "申报成功概率（0.0 至 1.0）"
          }
        },
        "type": "object",
        "required": [
          "enterprise_id",
          "policy_title",
          "policy_summary",
          "success_probability"
        ],
        "title": "CalculateROIRequest"
      },
      "FetchUrlRequest": {
        "properties": {
          "url": {
            "type": "string",
            "title": "Url",
            "description": "要抓取解析的政策网页 URL 链接"
          }
        },
        "type": "object",
        "required": [
          "url"
        ],
        "title": "FetchUrlRequest"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "MatchRequest": {
        "properties": {
          "enterprise_id": {
            "type": "string",
            "title": "Enterprise Id",
            "description": "企业 ID，如 'jyuh'"
          },
          "policy_title": {
            "type": "string",
            "title": "Policy Title",
            "description": "政策标题"
          },
          "policy_summary": {
            "type": "string",
            "title": "Policy Summary",
            "description": "政策摘要或内容"
          },
          "policy_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Policy Url",
            "description": "可选。政策网页链接",
            "default": ""
          }
        },
        "type": "object",
        "required": [
          "enterprise_id",
          "policy_title",
          "policy_summary"
        ],
        "title": "MatchRequest"
      },
      "ParseFileRequest": {
        "properties": {
          "file_path": {
            "type": "string",
            "title": "File Path",
            "description": "本地服务器上的政策文档文件相对/绝对路径"
          }
        },
        "type": "object",
        "required": [
          "file_path"
        ],
        "title": "ParseFileRequest"
      },
      "SaveProfileRequest": {
        "properties": {
          "enterprise_id": {
            "type": "string",
            "title": "Enterprise Id",
            "description": "企业 ID，例如 'tencent'"
          },
          "profile_yaml": {
            "type": "string",
            "title": "Profile Yaml",
            "description": "格式完备的 YAML 企业画像内容"
          }
        },
        "type": "object",
        "required": [
          "enterprise_id",
          "profile_yaml"
        ],
        "title": "SaveProfileRequest"
      },
      "StackingPolicyInput": {
        "properties": {
          "title": {
            "type": "string",
            "title": "Title",
            "description": "政策标题"
          },
          "summary": {
            "type": "string",
            "title": "Summary",
            "description": "政策摘要或内容"
          },
          "url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Url",
            "description": "可选。政策链接",
            "default": ""
          },
          "success_probability": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Success Probability",
            "description": "可选。申报成功概率"
          },
          "recommendation_score": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Recommendation Score",
            "description": "可选。推荐等级分数"
          }
        },
        "type": "object",
        "required": [
          "title",
          "summary"
        ],
        "title": "StackingPolicyInput"
      },
      "StackingRequest": {
        "properties": {
          "enterprise_id": {
            "type": "string",
            "title": "Enterprise Id",
            "description": "企业 ID，如 'jyuh'"
          },
          "policies": {
            "items": {
              "$ref": "#/components/schemas/StackingPolicyInput"
            },
            "type": "array",
            "title": "Policies",
            "description": "要进行叠加优化组合分析的政策列表"
          }
        },
        "type": "object",
        "required": [
          "enterprise_id",
          "policies"
        ],
        "title": "StackingRequest"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      },
      "WriteReportRequest": {
        "properties": {
          "enterprise_id": {
            "type": "string",
            "title": "Enterprise Id",
            "description": "企业 ID，如 'jyuh'"
          },
          "filename": {
            "type": "string",
            "title": "Filename",
            "description": "保存的文件名，如 'policy_analysis_report.md'"
          },
          "markdown_content": {
            "type": "string",
            "title": "Markdown Content",
            "description": "完整的 Markdown 报告文本内容"
          }
        },
        "type": "object",
        "required": [
          "enterprise_id",
          "filename",
          "markdown_content"
        ],
        "title": "WriteReportRequest"
      }
    }
  }
}